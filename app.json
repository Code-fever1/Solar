{
  "expo": {
    "name": "Voltix",
    "slug": "voltix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/meter.png",
    "scheme": "voltix",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/meter.png"
    },
    "android": {
      "icon": "./assets/images/meter-square.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/meter-adaptive.png",
        "backgroundColor": "#0A0E1A"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.voltix.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/with-android-cleartext-solar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/loading.jpeg",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#000000",
            "image": "./assets/images/loading.jpeg"
          },
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/loading.jpeg"
          },
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/loading.jpeg"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
