# Copy to .env at the repo root and fill in real values. Never commit .env.
# '#' inside a value is kept. Do not put inline comments on a value line.
# Do not prefix device keys or passwords with EXPO_PUBLIC_. Expo inlines those into the app binary.
# Empty values are safe: the code keeps its built-in default, or skips an optional probe.

# --- Expo app and Android cleartext plugin (inlined at bundle / prebuild time) ---

# API host only. No scheme, port, or path.
EXPO_PUBLIC_API_HOST=
# API port used with EXPO_PUBLIC_API_HOST. Default 3001 when empty.
EXPO_PUBLIC_API_PORT=3001
# Optional full solar base, including /api/solar. Overrides host and port when set.
EXPO_PUBLIC_SOLAR_API_URL=
# Optional overlay live URL. Defaults to the solar base plus /live.
EXPO_PUBLIC_SOLAR_LIVE_URL=

# --- Solar backend (backend/backend_api.js, unified_solar_routes.js) ---

# Mongo connection string. Default mongodb://localhost:27017 when empty.
MONGO_URI=mongodb://localhost:27017
# Mongo database name. Default ont_monitor when empty.
MONGO_DB=ont_monitor
# HTTP listen port for the API process. Default 3001 when empty.
PORT=3001
# Modem request timeout in milliseconds. Default 15000 when empty.
MODEM_TIMEOUT_MS=15000
# Home WAN address for the router reachability probe. Leave empty to skip that probe.
HOME_PUBLIC_IP=
# Inverter direct TCP address. Leave empty to use HOME_PUBLIC_IP. If both are empty, the direct probe is skipped.
INVERTER_DIRECT_IP=
# Inverter direct TCP port. Default 3286 when empty.
INVERTER_DIRECT_PORT=3286
# InverterZone cloud device id.
INVERTER_ZONE_DEVICE_ID=
# Older name for the same InverterZone device id. Used only when INVERTER_ZONE_DEVICE_ID is empty.
INVERTERZONE_DEVICE_ID=

# --- TOMZN local poller (backend/tuya_local_poll.py) ---

# Tuya device id for the local meter.
TOMZN_DEVICE_ID=
# Meter LAN or WAN address. Falls back to HOME_PUBLIC_IP when empty.
TOMZN_DEVICE_IP=
# Tuya local key for that meter.
TOMZN_LOCAL_KEY=
# Local Tuya TCP port. Default 6668 when empty.
TOMZN_DEVICE_PORT=6668

# --- PM2 paths (backend/ecosystem.config.js) ---

# Directory that holds the deployed backend files. Default is the home directory of the user who starts PM2.
DEPLOY_HOME=
# Absolute path to the API entry file. Default is DEPLOY_HOME/backend_api.js.
BACKEND_SCRIPT=
# Working directory for the API process. Default is DEPLOY_HOME.
BACKEND_CWD=
# Absolute path to the worker entry file. Default is DEPLOY_HOME/acs-worker/index.js.
ONT_WORKER_SCRIPT=
# Working directory for the worker process. Default is DEPLOY_HOME.
ONT_WORKER_CWD=

# --- TypeScript backend (backend/src workers and prisma.config.ts) ---

# Postgres URL for Prisma. Placeholder only.
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@localhost:5432/<DB_NAME>
# Redis URL for the background workers. Default redis://localhost:6379 when empty.
REDIS_URL=redis://localhost:6379

# --- Local docker-compose Postgres (backend/docker-compose.yml) ---

# Database role created on first container start.
POSTGRES_USER=<DB_USER>
# Database password. Use a value you choose locally.
POSTGRES_PASSWORD=<DB_PASSWORD>
# Database name created on first container start.
POSTGRES_DB=<DB_NAME>
