# Rename this file to .env at the repo root before merging. .env is gitignored; do not commit it.
# Each value below was already in this repo or its git history, or is a built-in default from the code.
# A secret that was never committed is left as a placeholder. Do not invent one.
# '#' inside a value is kept. Do not put inline comments on a value line.
# Do not prefix device keys or passwords with EXPO_PUBLIC_. Expo inlines those into the app binary.

# --- Expo app and Android cleartext plugin (inlined at bundle / prebuild time) ---

# API host only. No scheme, port, or path. Previously hardcoded in the app client.
EXPO_PUBLIC_API_HOST=104.43.56.204
# API port used with EXPO_PUBLIC_API_HOST. Default 3001 when empty.
EXPO_PUBLIC_API_PORT=3001
# Optional full solar base, including /api/solar. Overrides host and port when set.
EXPO_PUBLIC_SOLAR_API_URL=http://104.43.56.204:3001/api/solar
# Optional overlay live URL. Defaults to the solar base plus /live.
EXPO_PUBLIC_SOLAR_LIVE_URL=http://104.43.56.204:3001/api/solar/live

# --- Solar backend (backend/backend_api.js, unified_solar_routes.js) ---

# Mongo connection string. Default mongodb://localhost:27017 when empty.
MONGO_URI=mongodb://localhost:27017
# Mongo database name. Default ont_monitor when empty.
MONGO_DB=ont_monitor
# HTTP listen port for the API process. Default 3001 when empty.
PORT=3001
# Modem request timeout in milliseconds. Default 15000 when empty.
MODEM_TIMEOUT_MS=15000
# Home WAN address for the router reachability probe. Leave empty to skip that probe.
HOME_PUBLIC_IP=113.203.197.44
# Inverter direct TCP address. Leave empty to use HOME_PUBLIC_IP. If both are empty, the direct probe is skipped.
# History also noted this public port forwarded to LAN 10.1.10.4:80. The probe used the public address.
INVERTER_DIRECT_IP=113.203.197.44
# Inverter direct TCP port. Default 3286 when empty.
INVERTER_DIRECT_PORT=3286
# InverterZone cloud device id.
INVERTER_ZONE_DEVICE_ID=500291B991A9
# Older name for the same InverterZone device id. Used only when INVERTER_ZONE_DEVICE_ID is empty.
INVERTERZONE_DEVICE_ID=500291B991A9

# --- TOMZN local poller (backend/tuya_local_poll.py) ---

# Tuya device id for the local meter.
TOMZN_DEVICE_ID=bfe285c48ecd96460b5zfm
# Meter LAN or WAN address. Falls back to HOME_PUBLIC_IP when empty.
TOMZN_DEVICE_IP=113.203.197.44
# Tuya local key for that meter. Quoted because the value contains '#'.
TOMZN_LOCAL_KEY="KDdxg#}[Y_j@1UP@"
# Local Tuya TCP port. Default 6668 when empty.
TOMZN_DEVICE_PORT=6668

# --- PM2 paths (backend/ecosystem.config.js) ---

# Directory that holds the deployed backend files. Default is the home directory of the user who starts PM2.
DEPLOY_HOME=/home/azureuser
# Absolute path to the API entry file. Default is DEPLOY_HOME/backend_api.js.
BACKEND_SCRIPT=/home/azureuser/backend_api.js
# Working directory for the API process. Default is DEPLOY_HOME.
BACKEND_CWD=/home/azureuser
# Absolute path to the worker entry file. Default is DEPLOY_HOME/acs-worker/index.js.
ONT_WORKER_SCRIPT=/home/azureuser/acs-worker/index.js
# Working directory for the worker process. Default is DEPLOY_HOME.
ONT_WORKER_CWD=/home/azureuser

# --- TypeScript backend (backend/src workers and prisma.config.ts) ---

# Postgres URL for Prisma. The full URL string was never committed.
# It is only the docker-compose user, password, database, and published port from history.
DATABASE_URL=postgresql://gridwise:gridwise_password@localhost:5432/gridwisedb
# Redis URL for the background workers. Default redis://localhost:6379 when empty. No password was committed.
REDIS_URL=redis://localhost:6379

# --- Local docker-compose Postgres (backend/docker-compose.yml) ---

# Database role created on first container start.
POSTGRES_USER=gridwise
# Database password previously committed in docker-compose.yml.
POSTGRES_PASSWORD=gridwise_password
# Database name created on first container start.
POSTGRES_DB=gridwisedb

# --- Deploy notes (not read by the app; previously committed in docs and build notes) ---

# SSH user for the Azure VM.
SSH_USER=azureuser
# Private-key path used in the SSH and SCP commands.
SSH_KEY_PATH=~/Documents/vm1_key_0322.pem
# Absolute form of that same key path, from the agent notes.
SSH_KEY_PATH_ABSOLUTE=/home/alijah/Documents/vm1_key_0322.pem
# Local checkout path from the agent notes.
LOCAL_PROJECT=/home/alijah/Documents/PROJECTS/Solar
# JDK path from the Android build notes.
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
# Wireless ADB serials from the build notes. The second value contains a space.
ADB_SERIAL=adb-R5CT40F8FRE-6IVUmr._adb-tls-connect._tcp
ADB_SERIAL_2="adb-R5CT40F8FRE-6IVUmr (2)._adb-tls-connect._tcp"
