# Copy to .env at the repo root and fill in real values. Never commit .env.
# With these set to the previous deployment, client and server behaviour is unchanged.
# Quotes are optional. '#' inside a value is kept (do not use inline comments).
# Do not put device keys or SSH material in EXPO_PUBLIC_* variables.
# Expo inlines those into the app binary.

# --- Expo app (read at bundle time: expo start, prebuild, EAS) ---
# Host only. Example: 203.0.113.10
EXPO_PUBLIC_API_HOST=
# Optional. Defaults to 3001.
EXPO_PUBLIC_API_PORT=3001
# Optional full override, including /api/solar.
# EXPO_PUBLIC_SOLAR_API_URL=http://203.0.113.10:3001/api/solar
# Optional overlay URL. Defaults to the solar base plus /live.
# EXPO_PUBLIC_SOLAR_LIVE_URL=

# --- Backend process (backend/backend_api.js and tuya_local_poll.py) ---
# MONGO_URI=mongodb://localhost:27017
# MONGO_DB=ont_monitor
# PORT=3001

# Home WAN address for the router reachability probe. The inverter TCP probe
# uses INVERTER_DIRECT_IP when set, otherwise this same address.
HOME_PUBLIC_IP=
# INVERTER_DIRECT_IP=
# INVERTER_DIRECT_PORT=3286

# InverterZone realtime device id. INVERTERZONE_DEVICE_ID is also accepted.
INVERTER_ZONE_DEVICE_ID=

# TOMZN meter local poll. TOMZN_DEVICE_IP falls back to HOME_PUBLIC_IP.
TOMZN_DEVICE_ID=
TOMZN_DEVICE_IP=
TOMZN_LOCAL_KEY=
# TOMZN_DEVICE_PORT=6668

# PM2 paths in backend/ecosystem.config.js. Default is the home of the user
# who starts PM2 (the account that owns ~/backend_api.js).
# DEPLOY_HOME=
# BACKEND_SCRIPT=
# BACKEND_CWD=
# ONT_WORKER_SCRIPT=
# ONT_WORKER_CWD=

# Local Postgres for backend/docker-compose.yml. Not used by the solar API.
# POSTGRES_USER=gridwise
# POSTGRES_PASSWORD=changeme
# POSTGRES_DB=gridwisedb

# Deploy placeholders (not read by the app): <SERVER_IP> <SSH_USER> <PATH_TO_KEY>
